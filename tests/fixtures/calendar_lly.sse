\n    \"name\": \"openFDA / ClinicalTrials.gov\",\n    \"url\": \"https://clinicaltrials.gov/study/NCT06945406\",\n    \"license\": \"public\"\n  },\n  \"data\": {\n    \"drug\": \"A Study of LY4057996 in Healthy Participants and Participants With Type 1 and Type 2 Diabetes\",\n    \"indication\": \"Diabetes Mellitus, Type 1, Diabetes Mellitus, Type 2\",\n    \"event_type\": \"trial_readout\",\n    \"phase\": \"PHASE1\",\n    \"status\": \"RECRUITING\",\n    \"from_store\": true\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"figi\": \"BBG000BNBDC2\",\n    \"cik\": \"0000059478\",\n    \"ticker\": \"LLY\",\n    \"name\": \"ELI LILLY & Co\"\n  },\n  \"type\": \"fda_event\",\n  \"direction\": \"forward\",\n  \"event_time\": \"2027-03-01\",\n  \"as_of\": \"2027-03-01\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"openFDA / ClinicalTrials.gov\",\n    \"url\": \"https://clinicaltrials.gov/study/NCT07215559\",\n    \"license\": \"public\"\n  },\n  \"data\": {\n    \"drug\": \"A Study of Macupatide (LY3532226) and Eloralintide (LY3841136), Alone or in Combination, in Adults With Obesity or Overweight and With Type 2 Diabetes\",\n    \"indication\": \"Obesity, Overweight, Diabetes Mellitus, Type 2\",\n    \"event_type\": \"trial_readout\",\n    \"phase\": \"PHASE2\",\n    \"status\": \"ACTIVE_NOT_RECRUITING\",\n    \"from_store\": true\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"figi\": \"BBG000BNBDC2\",\n    \"cik\": \"0000059478\",\n    \"ticker\": \"LLY\",\n    \"name\": \"ELI LILLY & Co\"\n  },\n  \"type\": \"fda_event\",\n  \"direction\": \"forward\",\n  \"event_time\": \"2027-03-01\",\n  \"as_of\": \"2027-03-01\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"openFDA / ClinicalTrials.gov\",\n    \"url\": \"https://clinicaltrials.gov/study/NCT07339722\",\n    \"license\": \"public\"\n  },\n  \"data\": {\n    \"drug\": \"A Study of LY4515100 in Healthy Participants\",\n    \"indication\": \"Healthy\",\n    \"event_type\": \"trial_readout\",\n    \"phase\": \"PHASE1\",\n    \"status\": \"RECRUITING\",\n    \"from_store\": true\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"ticker\": \"LLY\",\n    \"name\": \"ELI LILLY & Co\"\n  },\n  \"type\": \"thesis_impact\",\n  \"item\": \"events\",\n  \"direction\": \"backward\",\n  \"event_time\": \"2026-08-28T17:38:53Z\",\n  \"as_of\": \"2026-08-28T17:38:53Z\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"OptimistFi — investment thesis to read this data against\",\n    \"url\": \"https://optimistfi.com/stocks/LLY\",\n    \"license\": \"computed\"\n  },\n  \"data\": {\n    \"metric\": null,\n    \"analysis_context\": {\n      \"what_this_is\": \"How this data reads against the company's investment case: the one-line thesis, and for each claim the reading that supports it (helps) and the reading that challenges it (hurts), plus the single condition that would break the case. The interpretation that sits beside the figure.\",\n      \"thesis\": \"Eli Lilly’s recent step-change in revenue and profit is powered by a small number of high‑demand, high‑margin new medicines; if exclusivity, pricing power, and the company’s commercial/R&D engine hold, free cash flow will compound and fund further innovation and shareholder returns.\",\n      \"helps_and_hurts\": [\n        {\n          \"claim\": \"A small set of newly commercialized, high‑demand therapies are the primary causal driver of the…\",\n          \"helps\": \"revenue rose from 34.12B USD (FY 2023) to 45.04B USD (FY 2024) to 65.18B USD (FY 2025) — a…; corresponding net income rose from 5.24B USD (FY 2023) to 10.59B USD (FY 2024) to 20.64B USD…\",\n          \"hurts\": \"rapid approval and market penetration of a lower‑cost competing therapy (new…; major payer/insurer formulary exclusions or aggressive price‑negotiation…; regulatory safety action or label restrictions materially reducing eligible…\"\n        },\n        {\n          \"claim\": \"The company’s marketed portfolio currently enjoys high gross margins and pricing power…\",\n          \"helps\": \"gross profit (derived) increased from 27.04B USD (FY 2023) to 36.62B USD (FY 2024) to 54.13B…; operating cash flow rose in step with gross dollars: 4.24B USD (FY 2023) -> 8.82B USD (FY 2024) ->…\",\n          \"hurts\": \"systemic policy changes (U.S. federal/state price controls or EU reimbursement…; rapid commoditization or biosimilar entry that materially raises…; sustained manufacturing cost shocks or supply chain disruptions that raise COGS\"\n        },\n        {\n          \"claim\": \"Strong operating cash flow is the causal enabler of sustained R&D investment and…\",\n          \"helps\": \"operating cash flow increased materially from 4.24B USD (FY 2023) to 8.82B USD (FY 2024) to…; cash on hand rose (cash: 2.82B USD at 2023-12-31 to 7.27B USD at 2025-12-31) supporting liquidity\",\n          \"hurts\": \"series of high‑cost R&D failures or late‑stage trial discontinuations that…; need for large external capital (debt/equity) to fund required manufacturing or…; operational scaling failures (manufacturing capacity constraints) that prevent…\"\n        },\n        {\n          \"claim\": \"EPS and net income growth demonstrate operational leverage: as high‑margin franchises scale…\",\n          \"helps\": \"eps diluted rose from 5.80 USD (FY 2023) to 11.71 USD (FY 2024) to 22.95 USD (FY 2025); net income increased from 5.24B USD (FY 2023) to 10.59B USD (FY 2024) to 20.64B USD (FY 2025)…\",\n          \"hurts\": \"large, value‑destroying acquisitions or equity raises increasing share count…; material margin compression from price or cost pressure so rising revenue fails…; regulatory fines or litigation expenses that hit net income and reduce…\"\n        }\n      ],\n      \"breaks_the_case\": \"A sustained, structural loss of exclusivity/pricing power for the company’s top‑selling new medicines (via rapid competitive approvals, payer exclusions or regulatory/safety constraints) that leads to secular revenue decline rather than a temporary slowdown.\",\n      \"full_case\": \"available via get_thesis\"\n    }\n  }\n}"}],"structuredContent":{"result":[{"entity":{"figi":"BBG000BNBDC2","cik":"0000059478","ticker":"LLY","name":"ELI LILLY & Co"},"type":"fda_event","direction":"forward","event_time":"2027-02-01","as_of":"2027-02-01","confidence":"estimated","source":{"name":"openFDA / ClinicalTrials.gov","url":"https://clinicaltrials.gov/study/NCT04411654","license":"public"},"data":{"drug":"Phase 1/2 Clinical Trial of PR001 in Infants With Type 2 Gaucher Disease (PROVIDE)","indication":"Gaucher Disease, Type 2","event_type":"trial_readout","phase":"PHASE1, PHASE2","status":"ACTIVE_NOT_RECRUITING","from_store":true}},{"entity":{"figi":"BBG000BNBDC2","cik":"0000059478","ticker":"LLY","name":"ELI LILLY & Co"},"type":"fda_event","direction":"forward","event_time":"2027-02-01","as_of":"2027-02-01","confidence":"estimated","source":{"name":"openFDA / ClinicalTrials.gov","url":"https://clinicaltrials.gov/study/NCT06297590","license":"public"},"data":{"drug":"A First-In-Human Study of LY3954068 in Participants With Early Symptomatic Alzheimer's Disease","indication":"Alzheimer Disease","event_type":"trial_readout","phase":"PHASE1","status":"RECRUITING","from_store":true}},{"entity":{"figi":"BBG000BNBDC2","cik":"0000059478","ticker":"LLY","name":"ELI LILLY & Co"},"type":"fda_event","direction":"forward","event_time":"2027-02-01","as_of":"2027-02-01","confidence":"estimated","source":{"name":"openFDA / ClinicalTrials.gov","url":"https://clinicaltrials.gov/study/NCT06413706","license":"public"},"data":{"drug":"A Study Comparing Abemaciclib Plus Temozolomide to Temozolomide Monotherapy in Children and Young Adults With High-grade Glioma Following Radiotherapy","indication":"Glioma","event_type":"trial_readout","phase":"PHASE2","status":"ACTIVE_NOT_RECRUITING","from_store":true}},{"entity":{"figi":"BBG000BNBDC2","cik