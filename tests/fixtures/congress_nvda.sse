disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034424.pdf","license":"public"},"data":{"politician":"Tim Moore","chamber":"house","state_district":"NC14","txn_type":"sell","asset":"NVIDIA Corporation - Common Stock (NVDA)","asset_type":"ST","amount_low":15001,"amount_high":50000,"disclosure_date":"2026-04-24","doc_id":"20034424","index_year":2026}},{"entity":{"figi":"BBG000BBJQV0","cik":"0001045810","ticker":"NVDA","name":"NVIDIA CORP"},"type":"gov_trade","direction":"backward","event_time":"2026-03-13","as_of":"2026-04-07","confidence":"confirmed","source":{"name":"US House Clerk PTR","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034285.pdf","license":"public"},"data":{"politician":"Gilbert Cisneros","chamber":"house","state_district":"CA31","txn_type":"buy","asset":"NVIDIA Corporation - Common Stock (NVDA)","asset_type":"ST","account":"150 Main Street Trust > Bank of America","amount_low":1001,"amount_high":15000,"disclosure_date":"2026-04-06","doc_id":"20034285","index_year":2026}},{"entity":{"figi":"BBG000BBJQV0","cik":"0001045810","ticker":"NVDA","name":"NVIDIA CORP"},"type":"gov_trade","direction":"backward","event_time":"2026-02-25","as_of":"2026-04-03","confidence":"confirmed","source":{"name":"US House Clerk PTR","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20034158.pdf","license":"public"},"data":{"politician":"Daniel Meuser","chamber":"house","state_district":"PA09","txn_type":"sell","asset":"NVIDIA Corporation - Common Stock (NVDA)","asset_type":"ST","owner":"spouse","account":"Schwab Brokerage Account","amount_low":1001,"amount_high":15000,"disclosure_date":"2026-03-09","doc_id":"20034158","index_year":2026}},{"entity":{"ticker":"NVDA","name":"NVIDIA CORP"},"type":"thesis_impact","item":"congress trades","direction":"backward","event_time":"2026-08-28T17:34:59Z","as_of":"2026-08-28T17:34:59Z","confidence":"estimated","source":{"name":"OptimistFi — investment thesis to read this data against","url":"https://optimistfi.com/stocks/NVDA","license":"computed"},"data":{"metric":null,"analysis_context":{"what_this_is":"How this data reads against the company's investment case: the one-line thesis, and for each claim the reading that supports it (helps) and the reading that challenges it (hurts), plus the single condition that would break the case. The interpretation that sits beside the figure.","thesis":"NVIDIA converts an outsized and growing wave of AI datacenter demand into very high-margin profits because its accelerator hardware + software ecosystem are the default choice for training and inference at scale.","helps_and_hurts":[{"claim":"NVIDIA's developer-facing software and ecosystem create switching costs that convert AI demand…","helps":"Revenue grew from $26.974B (FY2023) to $215.938B (FY2026), showing sustained, repeatable demand expansion tied to AI…; Item 1 Business describes NVIDIA as a pioneer in accelerated computing, implying a software+hardware ecosystem…","hurts":"Hyperscalers develop and deploy custom accelerators at scale (e.g., in-house ASICs) and retool frameworks to favor…; Competitors (AMD, Intel, or cloud-vendor silicon) achieve software/driver parity and win benchmark-based migrations for…"},{"claim":"NVIDIA's architecture and scale give it pricing power that keeps gross margin very high…","helps":"Gross profit expanded from $15.356B (FY2023) to $153.463B (FY2026), implying consistently high gross dollars as revenue…; Operating income and net income grew faster than revenue, consistent with margin expansion and pricing power…","hurts":"Competitors introduce lower-cost accelerators with comparable perf/W that force price competition (AMD MI-series…; Large customers secure long-term supply agreements or volume discounts that materially reduce ASPs."},{"claim":"Growing AI datacenter deployments convert into outsized operating cash flow because customers…","helps":"Operating cash flow rose from $5.641B (FY2023) to $102.718B (FY2026), demonstrating exceptional cash conversion as AI…; Operating income and net income increases align with cash flow expansion, indicating underlying economics are…","hurts":"Hyperscalers internalize accelerator production or shift procurement to cloud providers' capacity, reducing direct GPU…; Regulatory/export restrictions materially shrink addressable markets and thus reduce large enterprise/hyperscaler…"},{"claim":"NVIDIA's R&D-driven product leadership and scalable SG&A/R&D structure let operating margins…","helps":"Operating income expanded from $3.297B (FY2023) to $130.387B (FY2026), showing operating leverage as revenue scaled.; The company reported very large increases in operating profit across the period, consistent with sustained high margins.","hurts":"Sustained margin pressure from competitors or necessary expense increases (e.g., to match a competitor's ecosystem)…; Large M&A or one-time charges that erode operating income and distract management from core product execution."},{"claim":"NVIDIA's substantial free cash generation gives management optionality to invest in R&D and…","helps":"Reported cash and equivalents increased from $3.389B (FY2023) to $10.605B (FY2026) alongside massive operating cash…; Operating cash flow of $102.718B (FY2026) provides clear capacity for returns/ investments.","hurts":"Large, value-destroying acquisitions or sustained capital expenditures that drain cash without growing core economics.; A sudden drop in operating cash flow driven by lost large customers or product commoditization."}],"breaks_the_case":"Widespread migration of hyperscaler/large-enterprise training deployments off NVIDIA GPUs to alternative/custom accelerators at scale (a driver-level loss of share and pricing power) that precedes declines in revenue and margins.","full_case":"available via get_thesis"}}}]},"isError":false}}

