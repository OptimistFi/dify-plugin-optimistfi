data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\n  \"entity\": {\n    \"figi\": \"BBG003PHHZT1\",\n    \"cik\": \"0001682852\",\n    \"ticker\": \"MRNA\",\n    \"name\": \"Moderna, Inc.\"\n  },\n  \"type\": \"corporate_event\",\n  \"direction\": \"forward\",\n  \"event_time\": \"2026-11-05\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"computed from SEC 8-K Item 2.02 cadence\",\n    \"url\": \"https://optimistfi.com\",\n    \"license\": \"computed\"\n  },\n  \"data\": {\n    \"subtype\": \"earnings\",\n    \"estimate_basis\": \"52 weeks after the same quarter's report a year earlier (2025-11-06); median gap 92d over 8 filings\",\n    \"last_reported\": \"2026-07-31\",\n    \"projected_date\": \"2026-11-05\",\n    \"status\": \"projected\",\n    \"days_lapsed\": 0\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"ticker\": \"MRNA\",\n    \"name\": \"Moderna, Inc.\"\n  },\n  \"type\": \"thesis_impact\",\n  \"item\": \"events\",\n  \"direction\": \"backward\",\n  \"event_time\": \"2026-08-22T15:57:33Z\",\n  \"as_of\": \"2026-08-22T15:57:33Z\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"OptimistFi — investment thesis to read this data against\",\n    \"url\": \"https://optimistfi.com/stocks/MRNA\",\n    \"license\": \"computed\"\n  },\n  \"data\": {\n    \"metric\": null,\n    \"analysis_context\": {\n      \"what_this_is\": \"How this data reads against the company's investment case: the one-line thesis, and for each claim the reading that supports it (helps) and the reading that challenges it (hurts), plus the single condition that would break the case. The interpretation that sits beside the figure.\",\n      \"thesis\": \"Moderna is a high-variance platform bet: the business can create value if mRNA becomes a repeatable multi-product engine, but the stock fails if COVID-era cash is consumed before non-COVID products scale.\",\n      \"helps_and_hurts\": [\n        {\n          \"claim\": \"Moderna’s mRNA platform must produce commercially adopted products beyond the pandemic…\",\n          \"helps\": \"The company describes itself as advancing a technology platform to reimagine…; FY2025 annual GAAP revenue of $1.944 billion shows Moderna still has a…; FY2025 revenue is far below FY2022 annual GAAP revenue of $19.263 billion…\",\n          \"hurts\": \"Late-stage non-COVID mRNA programs fail efficacy or safety endpoints, showing…; Regulators require larger or slower safety databases for mRNA products, eroding…; Competing modalities from Pfizer, GSK, Novavax, or large pharma produce…\"\n        },\n        {\n          \"claim\": \"Seasonal respiratory vaccines must become a durable, priced commercial channel for Moderna…\",\n          \"helps\": \"FY2025 annual GAAP gross profit was $1.076 billion on $1.944 billion of…; Annual GAAP gross profit margin was roughly stable from FY2024 to FY2025…; FY2023 annual GAAP gross profit was only $2.155 billion on $6.848 billion of…\",\n          \"hurts\": \"CDC/ACIP or international advisory bodies narrow respiratory vaccine…; Pfizer, GSK, Novavax, or other vaccine competitors win share through better…; Manufacturing underutilization, product expiry, or inventory write-downs…\"\n        },\n        {\n          \"claim\": \"Moderna has to make its R&D, manufacturing…\",\n          \"helps\": \"FY2025 annual GAAP operating loss was $3.074 billion, improved from a $4.239…; The operating loss improved from FY2024 to FY2025 even as annual GAAP revenue…; FY2022 annual GAAP operating income was $9.420 billion, showing the model can…\",\n          \"hurts\": \"Large Phase 3 programs require sustained spending before commercial proof…; Manufacturing commitments, quality investments, or facility costs cannot be…; Commercial infrastructure must be rebuilt product-by-product rather than…\"\n        },\n        {\n          \"claim\": \"Management must pace pipeline investment so Moderna reaches value-inflecting approvals or…\",\n          \"helps\": \"FY2025 annual GAAP operating cash flow was negative $1.873 billion, better than…; Cash at FY2025 year-end was $2.595 billion.; Liabilities of $3.688 billion versus assets of $12.338 billion at FY2025…\",\n          \"hurts\": \"Clinical failures force Moderna to fund additional large trials without partner…; Commercial launches underperform while fixed manufacturing and inventory…; Management chooses acquisitions or pipeline expansion that increases burn…\"\n        },\n        {\n          \"claim\": \"The platform advantage depends on retaining specialized mRNA, clinical, regulatory…\",\n          \"helps\": \"Moderna reported approximately 4,700 full-time employees in 18 countries as of December 31, 2025.; The company’s stated business is built around advancing its technology platform, which requires specialized scientific…\",\n          \"hurts\": \"Key scientists, manufacturing leaders, or regulatory executives leave for…; Cost reductions eliminate capabilities needed for quality control, scale-up, or…; Regulatory or manufacturing-quality issues indicate the organization cannot…\"\n        }\n      ],\n      \"breaks_the_case\": \"The thesis is wrong if Moderna’s non-COVID mRNA products repeatedly fail to win broad regulatory recommendations, payer access, or share against Pfizer, GSK, Novavax, and other incumbents, demonstrating that the platform does not translate into preferred commercial products outside the pandemic setting.\",\n      \"full_case\": \"available via get_thesis\"\n    }\n  }\n}"}],"structuredContent":{"result":[{"entity":{"figi":"BBG003PHHZT1","cik":"0001682852","ticker":"MRNA","name":"Moderna, Inc."},"type":"corporate_event","direction":"forward","event_time":"2026-11-05","confidence":"estimated","source":{"name":"computed from SEC 8-K Item 2.02 cadence","url":"https://optimistfi.com","license":"computed"},"data":{"subtype":"earnings","estimate_basis":"52 weeks after the same quarter's report a year ear