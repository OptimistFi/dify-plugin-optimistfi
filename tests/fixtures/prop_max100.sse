data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"type\":\"prop_firms\",\"as_of\":\"2026-10-28\",\"confidence\":\"reported\",\"source\":{\"name\":\"Each firm's own public pages, read by OptimistFi\",\"url\":\"https://optimistfi.com/perps/props\",\"license\":\"computed\"},\"data\":{\"count\":21,\"firms\":[{\"slug\":\"bem-funding\",\"name\":\"BEM Funding\",\"website\":\"https://bemfunding.com/\",\"tradesOn\":[\"MetaTrader 5 or cTrader (simulated accounts)\"],\"markets\":\"crypto (140+ pairs on BEM One Only; not perps), plus forex, index, metal and energy CFDs\",\"onChain\":false,\"model\":\"BEM One or BEM One Only (1-step), or BEM Classic or Classic Swing (2-step) evaluation\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"9% (BEM One) / 6% (BEM One Only); 9% phase 1 / 4.5% phase 2 (Classic and Classic Swing)\",\"maxDailyLossPct\":\"3% (BEM One and One Only) / 4.5% (Classic and Classic Swing); based on the higher of balance or equity on BEM One and Classic, on balance on One Only and Classic Swing\",\"maxDrawdownPct\":\"6% trailing, stopping at the starting balance and breached on equity (BEM One and One Only); 9% static (Classic and Classic Swing)\",\"profitSplit\":\"80%\",\"payoutCadence\":\"On demand on BEM One (no day above 35% of funded profit; at least 50% of the daily drawdown amount) and One Only (30%, in the evaluation too); every 14 days on Classic and Classic Swing, or every 7 days with an add-on, with 3 trading days in each period; $150 minimum; USDC (ERC-20) under $1,500, Rise Works from $1,500; 2% processing fee\",\"maxLeverage\":\"1:2 on BTC and ETH and 1:1.5 on other crypto (BEM One, One Only and Classic); 1:1.5 and 1:1 on Classic Swing; the up-to-1:100 it advertises is forex leverage\",\"startingPriceUsd\":\"from $39 for a $5,000 account (Classic); One Only from $40 and BEM One from $47 (list prices; a sale was running)\",\"minTradingDays\":\"None (One, One Only); 3 days of 0.5%+ profit per phase (Classic, Classic Swing)\",\"consistencyRule\":\"No day above 35% of profit (funded One); 30% (One Only, evaluation and funded)\",\"usTraders\":\"No (on its restricted list)\",\"feeRefund\":\"With the first payout, with the refund add-on only\",\"newsTrading\":\"Allowed (One Only, One eval); 8-min window on non-crypto (funded One, both Classics)\",\"weekendHolding\":\"Allowed (One Only, Classic Swing, every evaluation); crypto only on funded One and Classic\",\"entry\":{\"usd\":39,\"accountUsd\":5000},\"checkedAt\":\"2026-10-15\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/bem-funding\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"Bex Software Development LLC-FZ\",\"founded\":\"2024\",\"yearsInOperation\":1,\"platforms\":[\"MetaTrader 5\",\"cTrader\"],\"maxAllocationUsd\":200000},\"assets\":[\"Crypto\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[{\"code\":\"NOLIMITS\",\"percentOff\":40,\"offer\":\"40% off BEM One Only accounts.\",\"appliesTo\":[{\"program\":\"BEM One Only\"}],\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://bemfunding.com/\"]},{\"code\":\"NOLIMITS\",\"percentOff\":30,\"offer\":\"30% off BEM One accounts.\",\"appliesTo\":[{\"program\":\"BEM One\"}],\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://bemfunding.com/\"]},{\"code\":\"NOLIMITS\",\"percentOff\":10,\"offer\":\"10% off BEM Classic accounts.\",\"appliesTo\":[{\"program\":\"BEM Classic\"}],\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://bemfunding.com/\"]},{\"code\":\"NOLIMITS\",\"percentOff\":5,\"offer\":\"5% off BEM Classic Swing accounts.\",\"appliesTo\":[{\"program\":\"BEM Classic Swing\"}],\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://bemfunding.com/\"]}],\"lists\":[\"static-drawdown\",\"under-50\",\"200k-accounts\"],\"trackedSince\":\"2026-10-12\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-28T07:20:17.959Z\"},{\"slug\":\"bitfunded\",\"name\":\"Bitfunded\",\"website\":\"https://www.bitfunded.com/\",\"tradesOn\":[\"own simulated platform (web and mobile app)\"],\"markets\":\"crypto (100+ cryptocurrencies), plus 20+ TradFi pairs\",\"onChain\":false,\"model\":\"2-Step, 1-Step or 1-Step Express evaluation; Instant Funding\",\"accountSizesUsd\":[2500,5000,10000,15000,25000,50000,100000,150000],\"profitTargetPct\":\"8% then 5% (2-Step); 10% (1-Step); 9% (1-Step Express); none on Instant Funding\",\"maxDailyLossPct\":\"5% (2-Step) / 4% (1-Step) / 3% (1-Step Express) / 4% (Instant Funding), a fixed percentage of the starting balance\",\"maxDrawdownPct\":\"10% then 8% (2-Step); 6% (1-Step); 3% (1-Step Express); 6% (Instant Funding); static, a fixed percentage of the starting balance\",\"profitSplit\":\"80% (60% on Instant Funding)\",\"payoutCadence\":\"On a Profit Sharing Day set 2 to 60 days out (30 by default); up to 2 payouts per 30 days per challenge, 5 across challenges, one a month after 10 payouts; Instant Funding one a month, 5% profit needed from the second; paid in USDT (TRC20, ERC20, BEP20), processed within 24 hours on working days\",\"maxLeverage\":\"1:5; a 20x upgrade sold on limited batches, 1,000 accounts from October 7, 2026 (sold out) and 500 more from October 10, on 1-Step, 2-Step and Express accounts of $5,000 to $150,000, from $47\",\"startingPriceUsd\":\"from $39 for a $5,000 account (1-Step Express, per its user guide); 2-Step from $79\",\"minTradingDays\":\"None per its FAQ and user guide (its terms list 5 per stage)\",\"consistencyRule\":\"None, except Instant Funding: no pair may make 60% or more of net profit in a payout period\",\"usTraders\":\"Yes (its blog says it accepts US traders)\",\"feeRefund\":\"With the third payout on 2-Step, not promo accounts (FAQ, guide); its terms say the first\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":39,\"accountUsd\":5000},\"checkedAt\":\"2026-10-26\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/bitfunded\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"Tronovix LTD\",\"founded\":\"2023\",\"yearsInOperation\":2,\"platforms\":[\"Bitfunded web platform\",\"Bitfunded mobile app\"],\"maxAllocationUsd\":150000},\"assets\":[\"Crypto\",\"TradFi\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"instant-funding\",\"us-traders\"],\"trackedSince\":\"2026-10-09\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-28T13:14:37.083Z\"},{\"slug\":\"breakout\",\"name\":\"Breakout\",\"website\":\"https://www.breakoutprop.com/\",\"tradesOn\":[\"own simulated platform (Breakout Terminal)\",\"DXtrade for pre-existing accounts only\"],\"markets\":\"crypto, index and commodity (S&P 500, Nasdaq 100, WTI crude, silver)\",\"onChain\":false,\"model\":\"1-step evaluation (Classic, Pro or Turbo)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"9% (Turbo) / 10% (Classic) / 12% (Pro), single phase\",\"maxDailyLossPct\":\"3%, recalculated daily at 00:30 UTC from balance (Classic, Pro and Turbo); none on Spark, which is sold out\",\"maxDrawdownPct\":\"3% (Turbo) / 5% (Pro) / 6% (Classic), static from starting balance\",\"profitSplit\":\"80%; 90% with an add-on bought at checkout\",\"payoutCadence\":\"Any time, weekdays and weekends, with no open positions; $50 minimum after split; no approval queue, most requests processed within hours; paid in USDC on Ethereum\",\"maxLeverage\":\"10x on BTC, the S&P 500 and the Nasdaq 100; 5x on ETH, SOL, other majors, WTI crude and silver; 3x on a listed set; 2x on all others (fixed per market, not user-adjustable; per its symbol list)\",\"startingPriceUsd\":\"from $20 for a $5,000 account (1-Step Turbo)\",\"minTradingDays\":\"None\",\"consistencyRule\":\"None\",\"usTraders\":\"Yes (not on its restricted list)\",\"feeRefund\":\"No (active evaluations refunded if KYC is rejected)\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":20,\"accountUsd\":5000},\"checkedAt\":\"2026-10-27\",\"programsCheckedAt\":\"2026-10-23\",\"page\":\"https://optimistfi.com/perps/props/breakout\",\"profile\":{\"country\":\"United States\",\"entity\":\"Breakout Trading Group, LLC\",\"founded\":\"2023-11\",\"yearsInOperation\":2,\"platforms\":[\"Breakout Terminal\"],\"maxAllocationUsd\":200000},\"assets\":[\"Crypto\",\"Indices\",\"Commodities\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"200k-accounts\",\"us-traders\",\"no-minimum-days\"],\"trackedSince\":\"2026-09-23\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T01:31:46.723Z\",\"rulesReadAt\":\"2026-10-28T01:31:46.723Z\"},{\"slug\":\"crypto-fund-trader\",\"name\":\"Crypto Fund Trader\",\"website\":\"https://cryptofundtrader.com/\",\"tradesOn\":[\"Bybit (trader's own account connected by API)\"],\"markets\":\"crypto (Bybit USDT pairs)\",\"onChain\":false,\"model\":\"1-phase or 2-phase evaluation (its Break evaluation is sold out); instant accounts also offered\",\"accountSizesUsd\":[2500,5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"8% phase 1 / 5% phase 2 (2-phase); 10% (1-phase)\",\"maxDailyLossPct\":\"5% (2-Phase; 6% with the Daily Drawdown add-on) / 4% (1-Phase and Instant), measured on equity against the balance at 00:05 UTC; Break accounts (sold out) list only a trailing loss limit (4% on $25,000 and $50,000, 3% on $100,000), no daily limit\",\"maxDrawdownPct\":\"10% fixed from initial balance (2-Phase; 12% with the Max Drawdown add-on); 6% trailing from the highest balance, checked on equity, that stops at the initial balance (1-Phase); 6% overall (Instant)\",\"profitSplit\":\"80% on 1-Phase and 2-Phase funded accounts, up to 90% with the 90% Bonus Performance add-on; Instant accounts scale from 50% to 90%\",\"payoutCadence\":\"After at least 15 traded days or every 30 calendar days (every 7 traded days with the Weekly Payouts add-on); Instant accounts can also withdraw at 10% profit with no minimum days; Break accounts (sold out) pay on demand under a 40% consistency rule; paid by bank transfer (EUR or USD) or crypto (USDT ERC20/TRC20, BTC, ETH)\",\"maxLeverage\":\"Up to 1:100 on Bybit accounts, depending on the instrument\",\"startingPriceUsd\":\"from $40 for a $5,000 account (1-phase)\",\"minTradingDays\":\"None to pass; 15 traded or 30 calendar days before a payout; none for Instant at 10% profit\",\"consistencyRule\":\"None (2-Phase, 1-Phase, Instant)\",\"usTraders\":\"Yes (no country limits on Match-Trader or Bybit, Bybit's own terms apply; MT5 excludes US)\",\"feeRefund\":\"Only within 14 days of purchase, before any trade\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":40,\"accountUsd\":5000},\"checkedAt\":\"2026-10-15\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/crypto-fund-trader\",\"profile\":{\"country\":\"Switzerland\",\"entity\":\"SWISS RLCRATES AG\",\"founded\":\"2022-11\",\"yearsInOperation\":3,\"platforms\":[\"MetaTrader 5\",\"Match-Trader\",\"Bybit (own account)\"],\"maxAllocationUsd\":300000},\"assets\":[\"Crypto\"],\"offers\":[{\"code\":\"BOO20\",\"percentOff\":20,\"offer\":\"20% off every 2-Phase, 1-Phase and Instant account.\",\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://cryptofundtrader.com/\"]}],\"lists\":[\"static-drawdown\",\"under-50\",\"instant-funding\",\"200k-accounts\",\"us-traders\"],\"trackedSince\":\"2026-09-23\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-27\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-27T07:38:00.581Z\"},{\"slug\":\"e8-markets\",\"name\":\"E8 Markets\",\"website\":\"https://e8markets.com/\",\"tradesOn\":[\"E8 Terminal, its own simulated platform (prices, spreads and funding from Hyperliquid's feed)\"],\"markets\":\"crypto, stock, index, metal, energy and forex\",\"onChain\":false,\"model\":\"1-step evaluation (E8 One or E8 Pro, Perpetual Futures market)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000,400000,500000],\"profitTargetPct\":\"E8 One: 1.5 times the drawdown chosen at checkout (9% at the 6% default); E8 Pro: equal to the drawdown (8% at the 8% default)\",\"maxDailyLossPct\":\"E8 Pro: 2.5%; E8 One: set by the drawdown chosen at checkout, 3% with a 4% drawdown and 4% with the 6% default, higher with the larger drawdowns; a fixed dollar amount from the initial balance, reset at 00:00 server time\",\"maxDrawdownPct\":\"E8 One: 4%, 6% (default), 8%, 10% or 14%, dynamic (rises with closed profit, locks at the starting balance); E8 Pro: 6%, 8% or 10%, static (moves up to the starting balance once the first payout is processed)\",\"profitSplit\":\"80% by default; 90% or 100% (E8 One) or 100% (E8 Pro) chosen at checkout\",\"payoutCadence\":\"E8 One: on demand under a 40% best-day rule, first payout as early as 3 days into the funded stage, and each payout must exceed half the daily loss limit (over $2,000 on a $100,000 account at 4%); E8 Pro: daily, 1% minimum profit; $100 minimum on every product; paid through Rise or WorkMarket (Aeropay in the US)\",\"maxLeverage\":\"15x on Bitcoin and Ether; 2x on other crypto; 5x on stocks; 15x on indices, metals and energy; 25x on forex\",\"startingPriceUsd\":\"from $28 for a $5,000 E8 Pro account with a 6% drawdown; E8 One from $40 with a 4% drawdown (list prices; a discount code was offered at checkout)\",\"minTradingDays\":\"None; E8 One's first payout comes 3+ days into the funded stage\",\"consistencyRule\":\"No day above 40% of profit (funded E8 One); E8 Pro caps daily profit at 2%\",\"usTraders\":\"Yes (not on its restricted list)\",\"feeRefund\":\"Only if unused, within 30 days of purchase; none for crypto payments\",\"newsTrading\":\"Allowed (E8 Pro); not within 5 min of high-impact news (funded E8 One)\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":28,\"accountUsd\":5000},\"checkedAt\":\"2026-10-23\",\"programsCheckedAt\":\"2026-10-23\",\"page\":\"https://optimistfi.com/perps/props/e8-markets\",\"profile\":{\"country\":\"United States\",\"entity\":\"E8 Funding LLC\",\"founded\":\"2021\",\"yearsInOperation\":4,\"platforms\":[\"E8 Terminal\",\"MetaTrader 5\",\"TradeLocker\",\"cTrader\",\"MatchTrader\"],\"maxAllocationUsd\":1000000},\"assets\":[\"Crypto\",\"Stocks\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"stock-perps\",\"hyperliquid\",\"200k-accounts\",\"us-traders\"],\"trackedSince\":\"2026-10-11\",\"stockPerpCap\":{\"leverage\":5},\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-23\",\"pricesReadAt\":\"2026-10-28T01:31:46.723Z\",\"rulesReadAt\":\"2026-10-16T21:07:46.189Z\"},{\"slug\":\"for-traders\",\"name\":\"For Traders\",\"website\":\"https://fortraders.com/\",\"tradesOn\":[\"MetaTrader 5 demo accounts (not offered in the USA)\",\"TradeLocker demo accounts\"],\"markets\":\"crypto (70+ coins, traded through the weekend; not perps)\",\"onChain\":false,\"model\":\"Fast or Fast PRO (1-step evaluation), or Instant (no evaluation)\",\"accountSizesUsd\":[3000,6000,15000,25000,50000,100000],\"profitTargetPct\":\"10% (Fast) / 6% (Fast PRO); none on Instant\",\"maxDailyLossPct\":\"3% (Fast and Instant); none on Fast PRO\",\"maxDrawdownPct\":\"6% trailing (Fast) / 4% trailing end-of-day (Fast PRO) / 5% trailing (Instant)\",\"profitSplit\":\"80% (Fast) / 90% (Fast PRO) / 70% rising 5% per reward to 90% (Instant)\",\"payoutCadence\":\"On demand on Fast PRO, under a 35% consistency rule, capped at 3% of balance ($750 to $3,000) on early rewards, rising to 5% and then 10%; every 14 days on Fast and Instant (up to $15,000 a reward); $100 minimum; bank transfer or crypto\",\"maxLeverage\":\"1:5 on BTC and ETH and 1:2 on other pairs (Fast and Instant); 1:20 on every pair (Fast PRO)\",\"startingPriceUsd\":\"from $59 for a $6,000 account (Fast); Fast PRO from $137 for $25,000; Instant from $49 for $3,000 (list prices; a discount code was running)\",\"minTradingDays\":\"6 profitable days of 0.5%+ (Fast); 4 (Fast PRO); 7 (Instant)\",\"consistencyRule\":\"None (Fast); 35% (funded Fast PRO); 15% (Instant)\",\"usTraders\":\"Yes (not on its restricted list)\",\"feeRefund\":\"As a bonus with the fourth payout (Fast, Fast PRO)\",\"newsTrading\":\"Allowed per its help center; its rules page bars funded trades 5 min around news\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":59,\"accountUsd\":6000},\"checkedAt\":\"2026-10-15\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/for-traders\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"BLN Tech Club DMCC\",\"founded\":\"2023\",\"yearsInOperation\":2,\"platforms\":[\"MetaTrader 5\",\"TradeLocker\",\"cTrader\"],\"maxAllocationUsd\":300000},\"assets\":[\"Crypto\"],\"offers\":[{\"code\":\"HALLOWEEN25\",\"percentOff\":25,\"offer\":\"25% off every trading account.\",\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]},{\"code\":\"NEW20\",\"percentOff\":20,\"offer\":\"20% off for new customers.\",\"firstPurchaseOnly\":true,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]},{\"code\":\"TRADE15\",\"percentOff\":15,\"offer\":\"15% off every plan.\",\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]}],\"lists\":[\"instant-funding\",\"no-daily-loss-limit\",\"us-traders\"],\"trackedSince\":\"2026-10-12\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-15\",\"rulesChangedSince\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-27T19:11:04.870Z\"},{\"slug\":\"fundednext\",\"name\":\"FundedNext\",\"website\":\"https://fundednext.com/\",\"tradesOn\":[\"simulated CFD account\"],\"markets\":\"crypto CFDs, plus forex, index, commodity and stock CFDs\",\"onChain\":false,\"model\":\"Stellar 2-Step, Stellar Lite (2-step), Stellar 1-Step, or Stellar Instant (no evaluation)\",\"accountSizesUsd\":[2000,5000,6000,10000,15000,20000,25000,50000,100000,200000],\"profitTargetPct\":\"8% then 5% (Stellar 2-Step); 10% (Stellar 1-Step); 8% then 4% (Stellar Lite); none on Stellar Instant\",\"maxDailyLossPct\":\"5% (Stellar 2-Step), 4% (Stellar Lite), 3% (Stellar 1-Step) of initial balance, on the day's closed and open results, resetting at 00:00 server time; none on Stellar Instant\",\"maxDrawdownPct\":\"10% (Stellar 2-Step), 6% (Stellar 1-Step), 8% (Stellar Lite), static; 6% trailing on Stellar Instant\",\"profitSplit\":\"80% on Stellar 1-Step and the Standard structure, 90% after Scale-Up; 60% (3 Day) or 90% (On-Demand) when chosen at checkout on Stellar 2-Step and Lite; 70% on Stellar Instant, 80% from Tier 3; a Lifetime 95% add-on keeps 95% (not on Instant)\",\"payoutCadence\":\"Standard: first after 21 days, then every 14 days (Stellar 2-Step); every 10 business days (Stellar Lite); every 5 business days (Stellar 1-Step); 3 Day (2-Step, Lite): every 3 days, with three profitable days of at least 1% per cycle; On-Demand (2-Step, Lite): on request after 2% growth under a 40% consistency rule; Stellar Instant: on demand at 5% growth, or every 14 days at 1%; paid in USDT, USDC, Confirmo, RiseWorks, bank transfer, card or an FNmarkets deposit\",\"maxLeverage\":\"1:1 on crypto on every Stellar model\",\"startingPriceUsd\":\"from $32.99 for a $5,000 account (Stellar Lite)\",\"minTradingDays\":\"2 (1-Step, Lite Standard); 5 (2-Step, Lite 3 Day/On-Demand), per phase; none (Instant)\",\"consistencyRule\":\"40% with On-Demand payouts (2-Step, Lite); none otherwise\",\"usTraders\":\"Yes (it accepts US traders for all Stellar accounts, on Match-Trader only)\",\"feeRefund\":\"With the first payout (2-Step); the third (1-Step, Lite); none (Instant)\",\"