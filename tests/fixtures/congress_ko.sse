ta\": {\n    \"politician\": \"Josh Gottheimer\",\n    \"chamber\": \"house\",\n    \"state_district\": \"NJ05\",\n    \"txn_type\": \"buy\",\n    \"asset\": \"Coca-Cola Company (KO)\",\n    \"asset_type\": \"ST\",\n    \"owner\": \"joint\",\n    \"account_not_read\": true,\n    \"amount_low\": 1001,\n    \"amount_high\": 15000,\n    \"disclosure_date\": \"2025-02-06\",\n    \"doc_id\": \"20026732\",\n    \"index_year\": 2025\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"figi\": \"BBG000BMX289\",\n    \"cik\": \"0000021344\",\n    \"ticker\": \"KO\",\n    \"name\": \"COCA COLA CO\"\n  },\n  \"type\": \"gov_trade\",\n  \"direction\": \"backward\",\n  \"event_time\": \"2024-12-16\",\n  \"as_of\": \"2025-01-14\",\n  \"confidence\": \"confirmed\",\n  \"source\": {\n    \"name\": \"US House Clerk PTR\",\n    \"url\": \"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2025/20026533.pdf\",\n    \"license\": \"public\"\n  },\n  \"data\": {\n    \"politician\": \"Josh Gottheimer\",\n    \"chamber\": \"house\",\n    \"state_district\": \"NJ05\",\n    \"txn_type\": \"sell\",\n    \"asset\": \"Coca-Cola Company (KO)\",\n    \"asset_type\": \"ST\",\n    \"owner\": \"joint\",\n    \"account_not_read\": true,\n    \"amount_low\": 1001,\n    \"amount_high\": 15000,\n    \"disclosure_date\": \"2025-01-07\",\n    \"doc_id\": \"20026533\",\n    \"index_year\": 2025\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"figi\": \"BBG000BMX289\",\n    \"cik\": \"0000021344\",\n    \"ticker\": \"KO\",\n    \"name\": \"COCA COLA CO\"\n  },\n  \"type\": \"gov_trade\",\n  \"direction\": \"backward\",\n  \"event_time\": \"2024-12-16\",\n  \"as_of\": \"2025-01-08\",\n  \"confidence\": \"confirmed\",\n  \"source\": {\n    \"name\": \"US House Clerk PTR\",\n    \"url\": \"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2025/20026535.pdf\",\n    \"license\": \"public\"\n  },\n  \"data\": {\n    \"politician\": \"Lloyd Doggett\",\n    \"chamber\": \"house\",\n    \"state_district\": \"TX37\",\n    \"txn_type\": \"buy\",\n    \"asset\": \"Coca-Cola Company (KO)\",\n    \"asset_type\": \"ST\",\n    \"account_not_read\": true,\n    \"amount_low\": 1001,\n    \"amount_high\": 15000,\n    \"disclosure_date\": \"2025-01-06\",\n    \"doc_id\": \"20026535\",\n    \"index_year\": 2025\n  }\n}"},{"type":"text","text":"{\n  \"entity\": {\n    \"ticker\": \"KO\",\n    \"name\": \"COCA COLA CO\"\n  },\n  \"type\": \"thesis_impact\",\n  \"item\": \"congress trades\",\n  \"direction\": \"backward\",\n  \"event_time\": \"2026-10-28T19:21:10Z\",\n  \"as_of\": \"2026-10-28T19:21:10Z\",\n  \"confidence\": \"estimated\",\n  \"source\": {\n    \"name\": \"OptimistFi — investment thesis to read this data against\",\n    \"url\": \"https://optimistfi.com/stocks/KO\",\n    \"license\": \"computed\"\n  },\n  \"data\": {\n    \"metric\": null,\n    \"analysis_context\": {\n      \"what_this_is\": \"How this data reads against the company's investment case: the one-line thesis, and for each claim the reading that supports it (helps) and the reading that challenges it (hurts), plus the single condition that would break the case. The interpretation that sits beside the figure.\",\n      \"thesis\": \"Coca-Cola turns iconic global brands and a concentrated, multi-channel bottler ecosystem into durable pricing power and high-margin cash flow, but that durability depends on maintaining bottler relationships, passing through input cost spikes, and sustaining unit-case demand as health and regulatory pressures grow.\",\n      \"helps_and_hurts\": [\n        {\n          \"claim\": \"Coca‑Cola's brand strength and concentrate-heavy mix allow it to pass through input-cost…\",\n          \"helps\": \"operating income increased to 13.76B (annual, FY2025) from 9.99B (FY2024), showing a sharp rebound in…; gross profit rose to 29.54B (FY2025) alongside revenue growth, suggesting margin recovery at the gross level\",\n          \"hurts\": \"sustained, sharp increases in key commodities (sugar, sweeteners, aluminum…; material disputes or breakdowns with large bottling partners that prevent…; major regulatory actions (e.g., broad sugar taxes) that force price cuts or…\"\n        },\n        {\n          \"claim\": \"Coca‑Cola's global brand portfolio and expansive distribution network sustain low-single-digit…\",\n          \"helps\": \"revenue rose from 45.75B (FY2023) to 47.06B (FY2024) and to 47.94B (FY2025), showing consistent…; MD&A states the company is investing in shaping its portfolio and transforming marketing/innovation to drive growth\",\n          \"hurts\": \"secular decline in sweetened beverage consumption accelerated by public-health…; retailers or foodservice channels favor competing private-label or competitive…; a major competitor launches a global alternative that captures share in key…\"\n        },\n        {\n          \"claim\": \"Coca‑Cola's free cash flow and operating cash conversion are vulnerable to bottling investments…\",\n          \"helps\": \"operating cash flow fell from 11.6B (FY2023) to 6.8B (FY2024) and modestly recovered to 7.41B…; MD&A highlights bottling investments, acquisitions and integration risks as cash uses and operational priorities\",\n          \"hurts\": \"large, value-dilutive bottling acquisitions that require significant upfront…; unexpected working-capital increases tied to inventory, receivables or…; prolonged elevated capex or supply-chain remediation costs\"\n        },\n        {\n          \"claim\": \"Future EPS expansion depends more on margin and cash conversion than on revenue growth alone…\",\n          \"helps\": \"eps diluted increased to 3.04 (FY2025) from 2.46 (FY2024), paralleling the operating-income rebound and supporting the…; net income rose to 13.11B (FY2025) from 10.63B (FY2024)\",\n          \"hurts\": \"increased share issuance or acquisition-related dilution without corresponding…; sustained margin pressure that reduces net income despite stable revenues; tax or one-time charges that materially depress net income\"\n        }\n      ],\n      \"breaks_the_case\": \"A driver-level, persistent loss of pricing power and/or bottler alignment that causes Coca‑Cola to be unable to offset commodity inflation and to lose unit-case share across multiple major regions, showing the concentrate model no longer converts scale into margin and cash.\",\n      \"full_case\": \"available via get_thesis\"\n    }\n  }\n}"}],"structuredContent":{"result":[{"entity":{"figi":"BBG000BMX289","cik":"0000021344","ticker":"KO","name":"COCA COLA CO"},"type":"gov_trade_summary","direction":"backward","event_time":"2026-08-31","as_of":"2026-09-25","confidence":"confirmed","source":{"name":"computed from US House Clerk PTR / Senate eFD records","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2026/20035491.pdf","license":"public"},"data":{"trades":25,"buys":14,"sells":11,"other":0,"lean":"buying","members":[{"name":"Lisa McClain","chamber":"house","trades":6,"buys":3,"sells":3},{"name":"Lloyd Doggett","chamber":"house","trades":6,"buys":6,"sells":0},{"name":"Josh Gottheimer","chamber":"house","trades":4,"buys":2,"sells":2},{"name":"Rob Bresnahan","chamber":"house","trades":2,"buys":0,"sells":2},{"name":"George Whitesides","chamber":"house","trades":1,"buys":0,"sells":1},{"name":"Jefferson Shreve","chamber":"house","trades":1,"buys":0,"sells":1},{"name":"Julia Letlow","chamber":"house","trades":1,"buys":1,"sells":0},{"name":"Kevin Hern","chamber":"house","trades":1,"buys":1,"sells":0}],"largest":{"politician":"Jefferson Shreve","txn_type":"sell","amount_low":100001,"amount_high":250000,"date":"2025-05-12"},"latest":{"politician":"Kevin Hern","txn_type":"buy","date":"2026-08-31"},"window":{"from":"2024-12-16","to":"2026-08-31"}}},{"entity":{"figi":"BBG000BMX289","cik":"0000021344","ticker":"KO","name":"COCA COLA CO"},"type":"gov_trade","direction":"backward","event_time":"2026-08-31","as_of":"2026-09-25","confidence":"confirme