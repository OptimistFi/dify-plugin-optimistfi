index_year":2025}},{"entity":{"figi":"BBG000BMX289","cik":"0000021344","ticker":"KO","name":"COCA COLA CO"},"type":"gov_trade","direction":"backward","event_time":"2025-01-16","as_of":"2025-02-10","confidence":"confirmed","source":{"name":"US House Clerk PTR","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2025/20026732.pdf","license":"public"},"data":{"politician":"Josh Gottheimer","chamber":"house","state_district":"NJ05","txn_type":"buy","asset":"Coca-Cola Company (KO)","asset_type":"ST","owner":"joint","account_not_read":true,"amount_low":1001,"amount_high":15000,"disclosure_date":"2025-02-06","doc_id":"20026732","index_year":2025}},{"entity":{"figi":"BBG000BMX289","cik":"0000021344","ticker":"KO","name":"COCA COLA CO"},"type":"gov_trade","direction":"backward","event_time":"2024-12-16","as_of":"2025-01-14","confidence":"confirmed","source":{"name":"US House Clerk PTR","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2025/20026533.pdf","license":"public"},"data":{"politician":"Josh Gottheimer","chamber":"house","state_district":"NJ05","txn_type":"sell","asset":"Coca-Cola Company (KO)","asset_type":"ST","owner":"joint","account_not_read":true,"amount_low":1001,"amount_high":15000,"disclosure_date":"2025-01-07","doc_id":"20026533","index_year":2025}},{"entity":{"figi":"BBG000BMX289","cik":"0000021344","ticker":"KO","name":"COCA COLA CO"},"type":"gov_trade","direction":"backward","event_time":"2024-12-16","as_of":"2025-01-08","confidence":"confirmed","source":{"name":"US House Clerk PTR","url":"https://disclosures-clerk.house.gov/public_disc/ptr-pdfs/2025/20026535.pdf","license":"public"},"data":{"politician":"Lloyd Doggett","chamber":"house","state_district":"TX37","txn_type":"buy","asset":"Coca-Cola Company (KO)","asset_type":"ST","account_not_read":true,"amount_low":1001,"amount_high":15000,"disclosure_date":"2025-01-06","doc_id":"20026535","index_year":2025}},{"entity":{"ticker":"KO","name":"COCA COLA CO"},"type":"thesis_impact","item":"congress trades","direction":"backward","event_time":"2026-10-28T19:21:10Z","as_of":"2026-10-28T19:21:10Z","confidence":"estimated","source":{"name":"OptimistFi — investment thesis to read this data against","url":"https://optimistfi.com/stocks/KO","license":"computed"},"data":{"metric":null,"analysis_context":{"what_this_is":"How this data reads against the company's investment case: the one-line thesis, and for each claim the reading that supports it (helps) and the reading that challenges it (hurts), plus the single condition that would break the case. The interpretation that sits beside the figure.","thesis":"Coca-Cola turns iconic global brands and a concentrated, multi-channel bottler ecosystem into durable pricing power and high-margin cash flow, but that durability depends on maintaining bottler relationships, passing through input cost spikes, and sustaining unit-case demand as health and regulatory pressures grow.","helps_and_hurts":[{"claim":"Coca‑Cola's brand strength and concentrate-heavy mix allow it to pass through input-cost…","helps":"operating income increased to 13.76B (annual, FY2025) from 9.99B (FY2024), showing a sharp rebound in…; gross profit rose to 29.54B (FY2025) alongside revenue growth, suggesting margin recovery at the gross level","hurts":"sustained, sharp increases in key commodities (sugar, sweeteners, aluminum…; material disputes or breakdowns with large bottling partners that prevent…; major regulatory actions (e.g., broad sugar taxes) that force price cuts or…"},{"claim":"Coca‑Cola's global brand portfolio and expansive distribution network sustain low-single-digit…","helps":"revenue rose from 45.75B (FY2023) to 47.06B (FY2024) and to 47.94B (FY2025), showing consistent…; MD&A states the company is investing in shaping its portfolio and transforming marketing/innovation to drive growth","hurts":"secular decline in sweetened beverage consumption accelerated by public-health…; retailers or foodservice channels favor competing private-label or competitive…; a major competitor launches a global alternative that captures share in key…"},{"claim":"Coca‑Cola's free cash flow and operating cash conversion are vulnerable to bottling investments…","helps":"operating cash flow fell from 11.6B (FY2023) to 6.8B (FY2024) and modestly recovered to 7.41B…; MD&A highlights bottling investments, acquisitions and integration risks as cash uses and operational priorities","hurts":"large, value-dilutive bottling acquisitions that require significant upfront…; unexpected working-capital increases tied to inventory, receivables or…; prolonged elevated capex or supply-chain remediation costs"},{"claim":"Future EPS expansion depends more on margin and cash conversion than on revenue growth alone…","helps":"eps diluted increased to 3.04 (FY2025) from 2.46 (FY2024), paralleling the operating-income rebound and supporting the…; net income rose to 13.11B (FY2025) from 10.63B (FY2024)","hurts":"increased share issuance or acquisition-related dilution without corresponding…; sustained margin pressure that reduces net income despite stable revenues; tax or one-time charges that materially depress net income"}],"breaks_the_case":"A driver-level, persistent loss of pricing power and/or bottler alignment that causes Coca‑Cola to be unable to offset commodity inflation and to lose unit-case share across multiple major regions, showing the concentrate model no longer converts scale into margin and cash.","full_case":"available via get_thesis"}}}]},"isError":false}}

