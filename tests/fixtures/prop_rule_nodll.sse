data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"type\":\"prop_firms\",\"as_of\":\"2026-10-28\",\"confidence\":\"reported\",\"source\":{\"name\":\"Each firm's own public pages, read by OptimistFi\",\"url\":\"https://optimistfi.com/perps/props\",\"license\":\"computed\"},\"data\":{\"count\":7,\"firms\":[{\"slug\":\"for-traders\",\"name\":\"For Traders\",\"website\":\"https://fortraders.com/\",\"tradesOn\":[\"MetaTrader 5 demo accounts (not offered in the USA)\",\"TradeLocker demo accounts\"],\"markets\":\"crypto (70+ coins, traded through the weekend; not perps)\",\"onChain\":false,\"model\":\"Fast or Fast PRO (1-step evaluation), or Instant (no evaluation)\",\"accountSizesUsd\":[3000,6000,15000,25000,50000,100000],\"profitTargetPct\":\"10% (Fast) / 6% (Fast PRO); none on Instant\",\"maxDailyLossPct\":\"3% (Fast and Instant); none on Fast PRO\",\"maxDrawdownPct\":\"6% trailing (Fast) / 4% trailing end-of-day (Fast PRO) / 5% trailing (Instant)\",\"profitSplit\":\"80% (Fast) / 90% (Fast PRO) / 70% rising 5% per reward to 90% (Instant)\",\"payoutCadence\":\"On demand on Fast PRO, under a 35% consistency rule, capped at 3% of balance ($750 to $3,000) on early rewards, rising to 5% and then 10%; every 14 days on Fast and Instant (up to $15,000 a reward); $100 minimum; bank transfer or crypto\",\"maxLeverage\":\"1:5 on BTC and ETH and 1:2 on other pairs (Fast and Instant); 1:20 on every pair (Fast PRO)\",\"startingPriceUsd\":\"from $59 for a $6,000 account (Fast); Fast PRO from $137 for $25,000; Instant from $49 for $3,000 (list prices; a discount code was running)\",\"minTradingDays\":\"6 profitable days of 0.5%+ (Fast); 4 (Fast PRO); 7 (Instant)\",\"consistencyRule\":\"None (Fast); 35% (funded Fast PRO); 15% (Instant)\",\"usTraders\":\"Yes (not on its restricted list)\",\"feeRefund\":\"As a bonus with the fourth payout (Fast, Fast PRO)\",\"newsTrading\":\"Allowed per its help center; its rules page bars funded trades 5 min around news\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":59,\"accountUsd\":6000},\"checkedAt\":\"2026-10-15\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/for-traders\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"BLN Tech Club DMCC\",\"founded\":\"2023\",\"yearsInOperation\":2,\"platforms\":[\"MetaTrader 5\",\"TradeLocker\",\"cTrader\"],\"maxAllocationUsd\":300000},\"assets\":[\"Crypto\"],\"offers\":[{\"code\":\"HALLOWEEN25\",\"percentOff\":25,\"offer\":\"25% off every trading account.\",\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]},{\"code\":\"NEW20\",\"percentOff\":20,\"offer\":\"20% off for new customers.\",\"firstPurchaseOnly\":true,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]},{\"code\":\"TRADE15\",\"percentOff\":15,\"offer\":\"15% off every plan.\",\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://fortraders.com/promo-code\"]}],\"lists\":[\"instant-funding\",\"no-daily-loss-limit\",\"us-traders\"],\"trackedSince\":\"2026-10-12\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-15\",\"rulesChangedSince\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-27T19:11:04.870Z\"},{\"slug\":\"fundednext\",\"name\":\"FundedNext\",\"website\":\"https://fundednext.com/\",\"tradesOn\":[\"simulated CFD account\"],\"markets\":\"crypto CFDs, plus forex, index, commodity and stock CFDs\",\"onChain\":false,\"model\":\"Stellar 2-Step, Stellar Lite (2-step), Stellar 1-Step, or Stellar Instant (no evaluation)\",\"accountSizesUsd\":[2000,5000,6000,10000,15000,20000,25000,50000,100000,200000],\"profitTargetPct\":\"8% then 5% (Stellar 2-Step); 10% (Stellar 1-Step); 8% then 4% (Stellar Lite); none on Stellar Instant\",\"maxDailyLossPct\":\"5% (Stellar 2-Step), 4% (Stellar Lite), 3% (Stellar 1-Step) of initial balance, on the day's closed and open results, resetting at 00:00 server time; none on Stellar Instant\",\"maxDrawdownPct\":\"10% (Stellar 2-Step), 6% (Stellar 1-Step), 8% (Stellar Lite), static; 6% trailing on Stellar Instant\",\"profitSplit\":\"80% on Stellar 1-Step and the Standard structure, 90% after Scale-Up; 60% (3 Day) or 90% (On-Demand) when chosen at checkout on Stellar 2-Step and Lite; 70% on Stellar Instant, 80% from Tier 3; a Lifetime 95% add-on keeps 95% (not on Instant)\",\"payoutCadence\":\"Standard: first after 21 days, then every 14 days (Stellar 2-Step); every 10 business days (Stellar Lite); every 5 business days (Stellar 1-Step); 3 Day (2-Step, Lite): every 3 days, with three profitable days of at least 1% per cycle; On-Demand (2-Step, Lite): on request after 2% growth under a 40% consistency rule; Stellar Instant: on demand at 5% growth, or every 14 days at 1%; paid in USDT, USDC, Confirmo, RiseWorks, bank transfer, card or an FNmarkets deposit\",\"maxLeverage\":\"1:1 on crypto on every Stellar model\",\"startingPriceUsd\":\"from $32.99 for a $5,000 account (Stellar Lite)\",\"minTradingDays\":\"2 (1-Step, Lite Standard); 5 (2-Step, Lite 3 Day/On-Demand), per phase; none (Instant)\",\"consistencyRule\":\"40% with On-Demand payouts (2-Step, Lite); none otherwise\",\"usTraders\":\"Yes (it accepts US traders for all Stellar accounts, on Match-Trader only)\",\"feeRefund\":\"With the first payout (2-Step); the third (1-Step, Lite); none (Instant)\",\"newsTrading\":\"Allowed; news-window profits count at 40% (funded, Instant)\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":32.99,\"accountUsd\":5000},\"checkedAt\":\"2026-10-26\",\"programsCheckedAt\":\"2026-10-28\",\"page\":\"https://optimistfi.com/perps/props/fundednext\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"GrowthNext F.Z.E.\",\"founded\":\"2022-03\",\"yearsInOperation\":4,\"platforms\":[\"MetaTrader 4\",\"MetaTrader 5\",\"cTrader\",\"Match-Trader\"],\"maxAllocationUsd\":4000000},\"assets\":[\"Crypto\",\"Stocks\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"instant-funding\",\"no-daily-loss-limit\",\"200k-accounts\",\"us-traders\"],\"trackedSince\":\"2026-10-09\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-27T20:41:06.427Z\",\"rulesReadAt\":\"2026-10-28T19:13:29.093Z\"},{\"slug\":\"kraken-prop\",\"name\":\"Kraken Prop\",\"website\":\"https://www.kraken.com/pro/prop\",\"tradesOn\":[\"Kraken Pro (web and mobile app), on a simulated Prop account\"],\"markets\":\"crypto and index\",\"onChain\":false,\"model\":\"1-step evaluation (Starter, Intermediate or Advanced; Lite on $50,000)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"10% (Starter) / 12% (Intermediate) / 9% (Advanced) / 6% (Lite)\",\"maxDailyLossPct\":\"3% of the balance at 00:30 UTC, checked against equity (Starter, Intermediate, Advanced); none on Lite\",\"maxDrawdownPct\":\"6% (Starter) / 5% (Intermediate) / 3% (Advanced), static from the starting balance; $1,500 trailing the highest closed balance on Lite\",\"profitSplit\":\"80%; 90% with an add-on bought at purchase for 20% of the plan price\",\"payoutCadence\":\"On request with no open positions or orders; reviewed within 24 hours (typically 12) and paid in USD or USDG to the trader's Kraken account; $50 minimum on Lite\",\"maxLeverage\":\"Up to 10x on BTC, the Nasdaq 100 and the S&P 500 (its August 18, 2026 update; its September guide still says 5x on BTC and ETH, 2x on other crypto), 5x on SOL and 3x on HYPE; up to 40x on the Nasdaq 100 and S&P 500 on Lite\",\"startingPriceUsd\":\"from $20 for a $5,000 account (Advanced)\",\"minTradingDays\":\"None\",\"consistencyRule\":\"None\",\"usTraders\":\"Yes (crypto only for US clients; not offered in Canada, India or the UK)\",\"feeRefund\":\"No\",\"newsTrading\":\"Allowed (its Prop page sets no restriction on trading strategy)\",\"weekendHolding\":\"Allowed (margin funding of 0.033% a day applies; 0.013% a day on XYZ100 and SP500 on Lite)\",\"entry\":{\"usd\":20,\"accountUsd\":5000},\"checkedAt\":\"2026-10-26\",\"programsCheckedAt\":\"2026-10-26\",\"page\":\"https://optimistfi.com/perps/props/kraken-prop\",\"profile\":{\"country\":\"British Virgin Islands\",\"entity\":\"Payward Oceanic Ltd.\",\"founded\":\"2026-05\",\"yearsInOperation\":0,\"platforms\":[\"Kraken Pro\"],\"maxAllocationUsd\":200000},\"assets\":[\"Crypto\",\"Indices\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"no-daily-loss-limit\",\"200k-accounts\",\"us-traders\",\"no-minimum-days\"],\"trackedSince\":\"2026-10-26\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-26\",\"rulesChangedSince\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-26T19:28:26.301Z\"},{\"slug\":\"myfundedperps\",\"name\":\"MyFundedPerps\",\"website\":\"https://myfundedperpetuals.com/\",\"tradesOn\":[\"own simulated platform (prices from Binance on most markets, and from Hyperliquid, Veranta or Ostium on the rest)\"],\"markets\":\"crypto, stock, commodity, index and FX\",\"onChain\":false,\"model\":\"1-step evaluation (Select, Prime, Signature or Elite)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000],\"profitTargetPct\":\"9% (Select) / 12% (Prime) / 10% (Signature) / 10% (Elite)\",\"maxDailyLossPct\":\"3% of starting balance, measured from start-of-day equity; resets at midnight New York time; none on Elite, unless bought with its 3% option\",\"maxDrawdownPct\":\"3% (Select) / 5% (Prime) / 6% (Signature), static, locking at the starting balance after the first withdrawal; 5% static on Elite, which never locks\",\"profitSplit\":\"80%; 90% with an upgrade bought at checkout\",\"payoutCadence\":\"One request per New York calendar day per funded account (Elite: anytime, no daily limit); $100 minimum gross profit (Elite: 1% of account size, $50 to $500); reviewed, then paid via Rise or as store credit; $100,000 lifetime payout cap per trader, counted after the split\",\"maxLeverage\":\"Set per market on its live exposure-caps table: 10x on BTC and gold, 8x on ETH and oil, 5x on SOL, BNB, silver and other commodities, 1x-3x on other crypto, 12x on the S&P 500, Nasdaq 100 and Dow 30, 5x on other indices, 4x on the six largest stocks, 3x on most others and 2x on a few, 50x on EUR, JPY and CAD pairs and 25x on GBP, AUD and CHF pairs. Elite accounts raise the S&P 500 and Nasdaq 100 to 40x, the Dow 30 to 25x, gold to 20x and oil to 10x\",\"startingPriceUsd\":\"from $40 for a $10,000 Select account\",\"minTradingDays\":\"None\",\"consistencyRule\":\"None\",\"usTraders\":\"Yes (not on its restricted list; Puerto Rico and the US Virgin Islands are)\",\"feeRefund\":\"Only if unused, within 48 hours of purchase (less a $25 fee)\",\"newsTrading\":\"Allowed; when funded, not from 10 min before to 2 min after high-impact news or earnings\",\"weekendHolding\":\"Allowed on 24/7 markets; FX and standard-hours indices close 15 min before Friday's close\",\"entry\":{\"usd\":40,\"accountUsd\":10000},\"checkedAt\":\"2026-10-26\",\"programsCheckedAt\":\"2026-10-23\",\"page\":\"https://optimistfi.com/perps/props/myfundedperps\",\"profile\":{\"country\":\"United States\",\"entity\":\"Funding Perpetuals Holdings, Inc.\",\"founded\":\"2026-09\",\"yearsInOperation\":0,\"platforms\":[\"MyFundedPerps web terminal\",\"REST API\",\"MCP server\"],\"maxAllocationUsd\":300000},\"assets\":[\"Crypto\",\"Stocks\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[{\"code\":\"ELITE\",\"percentOff\":25,\"offer\":\"25% off the first two purchases, then 20% off every purchase after.\",\"firstPurchaseOnly\":true,\"firstPurchases\":2,\"seenAt\":\"2026-10-28\",\"rounding\":\"dollar-down\",\"sources\":[\"https://myfundedperpetuals.com/\"]}],\"lists\":[\"static-drawdown\",\"under-50\",\"no-daily-loss-limit\",\"stock-perps\",\"us-traders\",\"no-minimum-days\"],\"trackedSince\":\"2026-09-23\",\"stockPerpCap\":{\"leverage\":3,\"note\":\"on most stocks\"},\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T01:31:46.723Z\",\"rulesReadAt\":\"2026-10-28T01:31:46.723Z\"},{\"slug\":\"upscale\",\"name\":\"Upscale\",\"website\":\"https://upscale.trade/\",\"tradesOn\":[\"own platform (TradingView-based terminal, oracle-priced perpetual contracts)\"],\"markets\":\"crypto, FX, commodity, index and stock\",\"onChain\":false,\"model\":\"2-phase (Basic) or 1-phase (Accelerated) evaluation; instant funding (Turbo)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"Basic: 5% phase 1 / 8% phase 2; Accelerated: 10%; Turbo: none\",\"maxDailyLossPct\":\"5% (Basic) / 3% (Accelerated) / none (Turbo), from start-of-day balance, reset 00:00 UTC\",\"maxDrawdownPct\":\"10% static (Basic; 8% at Phase 2 and funded on $200,000 Basic challenges bought since July 2026) / 6% static (Accelerated) / 6% trailing from highest balance (Turbo); funded static limits re-base on the balance left after each payout\",\"profitSplit\":\"80%; 90% with an upgrade bought with the challenge\",\"payoutCadence\":\"Every 14 calendar days with at least 5 profit days; per-cycle cap of 15%-50% of account size; USDT on TON, Base or BSC\",\"maxLeverage\":\"Basic and Accelerated: 100x forex, 15x US indices, 10x gold, silver, natural gas, copper, GER40, EU50 and KR200, 5x crypto, stocks and WTI; Turbo: 30x forex, 5x gold, silver and US indices, 3x natural gas, copper, GER40, EU50 and KR200, 2x crypto, stocks and WTI\",\"startingPriceUsd\":\"from $69 for a $5,000 crypto Basic account ($59 for the RWA version)\",\"minTradingDays\":\"3 profit days of 0.5%+ (Basic Stage 1, Accelerated); 5 (Basic Stage 2, each payout)\",\"consistencyRule\":\"No day at 30%+ of profit (Turbo, API accounts); none (Basic, Accelerated)\",\"usTraders\":\"No per its terms of use (its FAQ says it is available worldwide)\",\"feeRefund\":\"Only at the firm's discretion, per its terms of use\",\"newsTrading\":\"Allowed; US stocks go close-only 5 min around US macro releases\",\"weekendHolding\":\"Allowed; index positions opened or increased late Friday are closed in full\",\"entry\":{\"usd\":59,\"accountUsd\":5000},\"checkedAt\":\"2026-10-23\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/upscale\",\"profile\":{\"country\":\"Seychelles\",\"entity\":\"Innovix Ltd.\",\"founded\":\"2025-03\",\"yearsInOperation\":1,\"platforms\":[\"Upscale web terminal\",\"Telegram Mini App\",\"Upscale API\"],\"maxAllocationUsd\":500000},\"assets\":[\"Crypto\",\"Stocks\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"instant-funding\",\"no-daily-loss-limit\",\"stock-perps\",\"200k-accounts\"],\"trackedSince\":\"2026-09-23\",\"stockPerpCap\":{\"leverage\":5,\"note\":\"on Basic and Accelerated\"},\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-28T19:13:29.093Z\"},{\"slug\":\"vest-markets\",\"name\":\"Vest Markets (Vest Capital)\",\"website\":\"https://www.vestmarkets.com/\",\"tradesOn\":[\"Vest Markets' own perps platform (next.vestmarkets.com), on a Funded Account beside the trader's own Primary Account; every account is simulated per its prop terms\"],\"markets\":\"stock, ETF, index, commodity, FX and crypto (BTC, ETH and SOL only)\",\"onChain\":false,\"model\":\"1-step evaluation (target, daily loss limit and split chosen at checkout) or 2-step evaluation; Instant Accounts with no evaluation also offered\",\"accountSizesUsd\":[500,5000,10000,25000,50000],\"profitTargetPct\":\"1-step: 10% or 20%, chosen at checkout; 2-step: 10% phase 1 / 5% phase 2; Instant: none\",\"maxDailyLossPct\":\"3%, 4% or none, chosen at checkout (1-step); 3% (2-step); none (Instant); reset at 20:00 New York time from balance plus reserved collateral, checked against equity\",\"maxDrawdownPct\":\"6% static from starting capital, on equity (1-step and 2-step); on Instant, static and equal to the price paid: 2% on $500, 4% on $5,000 to $50,000\",\"profitSplit\":\"80% or 90%, chosen at checkout (1-step; 90% costs more); 80% (2-step); 95% (Instant)\",\"payoutCadence\":\"On demand, 24/7, with no cap on how often or how much; each claim credits the split to the trader's Vest Primary Account within 24 hours, withdrawable in USDC to a wallet; open positions may need closing first\",\"maxLeverage\":\"25x on BTC, 15x on ETH, 10x on SOL; 75x on the S&P 500 (ES), 50x on the Nasdaq 100, Russell 2000 and Dow; 25x on NVDA and gold (GC); 10x on WTI crude, TSLA, MU, INTC, SNDK and SPCX; 5x on all other stocks, ETFs, FX, silver, platinum, copper, Brent and natural gas; XRP and HYPE not tradeable funded (per its leverage table; the same page's text puts BTC at 15x)\",\"startingPriceUsd\":\"from $15 for a $5,000 account (2-Step); 1-Step from $25 with a 20% target; Instant Accounts from $10 for $500\",\"minTradingDays\":\"None\",\"consistencyRule\":\"None\",\"usTraders\":\"Yes (prop terms allow it; profit goes to a Vest exchange account, whose terms bar the US)\",\"feeRefund\":\"Only if unused: within 3 days of purchase, before any trade\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed; non-crypto markets lock from Friday evening to Sunday evening New York time\",\"entry\":{\"usd\":15,\"accountUsd\":5000},\"checkedAt\":\"2026-10-26\",\"programsCheckedAt\":\"2026-10-26\",\"page\":\"https://optimistfi.com/perps/props/vest-markets\",\"profile\":{\"country\":\"Panama\",\"entity\":\"Vest Exchange Inc.\",\"platforms\":[\"Vest Markets web terminal\"],\"maxAllocationUsd\":250000},\"assets\":[\"Crypto\",\"Stocks\",\"ETFs\",\"Indices\",\"Commodities\",\"Forex\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"instant-funding\",\"no-daily-loss-limit\",\"stock-perps\",\"us-traders\",\"no-minimum-days\"],\"trackedSince\":\"2026-10-13\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-26\",\"rulesChangedSince\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-27T19:11:04.870Z\"},{\"slug\":\"wencrypto\",\"name\":\"WenCrypto\",\"website\":\"https://wencrypto.com/\",\"tradesOn\":[\"Match-Trader (demo accounts)\"],\"markets\":\"crypto only (top 100 cryptocurrencies on CoinMarketCap; not perps; stablecoins are not tradable)\",\"onChain\":false,\"model\":\"Single Pass (1-step), Double Pass (2-step) or Buy Now Pay Later (1-step, most of the fee paid after passing)\",\"accountSizesUsd\":[5000,10000,20000,50000,100000],\"profitTargetPct\":\"9% (Single Pass); 10% phase 1 / 6% phase 2 (Double Pass); 4% (Buy Now Pay Later)\",\"maxDailyLossPct\":\"3% (Single Pass) / 5% (Double Pass), on balance or equity, reset 00:00 UTC; Buy Now Pay Later: no limit in the evaluation, 3% at end of day once funded\",\"maxDrawdownPct\":\"5% static (Single Pass); 8% static (Double Pass); Buy Now Pay Later: 8% static, measured end-of-day, in the evaluation, and 5% once funded (static on its pricing page, trailing end-of-day in its FAQ)\",\"profitSplit\":\"80%\",\"payoutCadence\":\"Every 10 business days, with KYC required to withdraw; Single Pass and Double Pass: first withdrawal capped at 6%, second at 8%, third and fourth unlimited, and the fee is refunded after three successful withdrawals\",\"maxLeverage\":\"5x on BTC and ETH; 2x on other crypto\",\"startingPriceUsd\":\"from $44 for a $5,000 account (Double Pass); Single Pass from $55; Buy Now Pay Later $5 up front and $69 after passing (list prices; a discount code was running)\",\"minTradingDays\":\"3 winning days of 1%+ (Single Pass, Double Pass); none (Buy Now Pay Later)\",\"consistencyRule\":\"20% before each withdrawal (funded Buy Now Pay Later)\",\"feeRefund\":\"After three withdrawals (Single Pass, Double Pass) per its FAQ; its terms say none\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":44,\"accountUsd\":5000},\"checkedAt\":\"2026-10-15\",\"programsCheckedAt\":\"2026-10-21\",\"page\":\"https://optimistfi.com/perps/props/wencrypto\",\"profile\":{\"country\":\"United Arab Emirates\",\"entity\":\"WEN LTD (registered in Saint Lucia)\",\"platforms\":[\"Match-Trader\"],\"maxAllocationUsd\":300000},\"assets\":[\"Crypto\"],\"offers\":[{\"code\":\"WEN\",\"percentOff\":25,\"offer\":\"25% off Single Pass and Double Pass accounts, every size.\",\"appliesTo\":[{\"program\":\"Single Pass\"},{\"program\":\"Double Pass\"}],\"firstPurchaseOnly\":false,\"seenAt\":\"2026-10-28\",\"sources\":[\"https://wencrypto.com/pricing\"]}],\"lists\":[\"static-drawdown\",\"under-50\",\"no-daily-loss-limit\"],\"trackedSince\":\"2026-10-12\",\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T20:44:45.738Z\",\"rulesReadAt\":\"2026-10-28T19:13:29.093Z\"}],\"pages\":{\"methodology\":\"https://optimistfi.com/perps/props/methodology\",\"changesLog\":\"https://optimistfi.com/perps/props/changes\",\"hyperliquidHub\":\"https://optimistfi.com/perps/props/hyperliquid\"},\"omitted\":{\"fields\":[\"programs\",\"changes\",\"sources\",\"notes\",\"bitcoin\",\"onChainRecord\"],\"in\":\"a named firm's record (firm=)\"}}}"}],"isError":false}}

