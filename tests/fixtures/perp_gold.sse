data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"entity\":{\"symbol\":\"XAU\",\"assetClass\":\"commodity\"},\"type\":\"perps\",\"as_of\":\"2026-10-28T23:00:00Z\",\"confidence\":\"reported\",\"source\":{\"name\":\"OptimistFi perps data layer — each venue's public market data, read hourly\",\"url\":\"https://optimistfi.com/perps/markets/xau\",\"license\":\"computed\"},\"data\":{\"base\":\"XAU\",\"assetClass\":\"commodity\",\"asOf\":\"2026-10-28T23:00:00Z\",\"venues\":28,\"totals\":{\"openInterestUsd\":2153441025,\"openInterestChange24h\":-0.01201,\"fundingRateHourlyOiWeighted\":2.445e-6,\"fundingRateAnnualizedOiWeighted\":0.02141,\"priceLow\":4026.95,\"priceHigh\":4046.08},\"fundingCumulative\":{\"1d\":{\"mexc:XAU_USDT\":0.00031,\"okx\":0.0003969,\"gate\":0.00038,\"tradexyz\":0.0001767,\"aster:XAUUSD1\":0.0002834,\"bitget\":0.000182,\"edgex\":0.0003593,\"lighter\":0.000105,\"extended\":0.000092,\"mexc:XAU_USDC\":0.000309,\"qfex\":0.00019,\"phemex\":0.0002977,\"aster:XAUUSDT\":0.0002349,\"htx\":0.00113,\"deribit\":0.0009242,\"kraken\":0.0004781,\"pacifica\":0.0002625,\"grvt\":0.000099,\"cryptocom\":0.0009479,\"gmx\":0.0004809,\"orderly\":0.000296,\"aevo\":0.00028,\"paradex\":0.0001716,\"bluefin\":0.0003},\"7d\":{\"mexc:XAU_USDT\":0.002221,\"okx\":0.002751,\"gate\":0.003631,\"tradexyz\":0.001716,\"aster:XAUUSD1\":0.002254,\"bitget\":0.00278,\"edgex\":0.002464,\"lighter\":0.00168,\"extended\":0.003305,\"mexc:XAU_USDC\":0.002223,\"qfex\":0.001134,\"phemex\":0.001812,\"aster:XAUUSDT\":0.00218,\"htx\":0.004225,\"deribit\":-0.002368,\"kraken\":0.009378,\"pacifica\":0.002536,\"grvt\":0.001049,\"cryptocom\":0.004505,\"gmx\":0.004052,\"orderly\":0.002035,\"aevo\":0.002245,\"paradex\":0.001466,\"bluefin\":0.005157},\"30d\":{\"mexc:XAU_USDT\":0.0064,\"okx\":0.007591,\"gate\":0.008237,\"tradexyz\":0.00567,\"aster:XAUUSD1\":0.005945,\"bitget\":0.01087,\"edgex\":0.007377,\"lighter\":0.007955,\"extended\":0.007923,\"mexc:XAU_USDC\":0.006388,\"qfex\":0.003144,\"phemex\":0.01436,\"aster:XAUUSDT\":0.006779,\"htx\":0.01454,\"deribit\":0.01136,\"kraken\":0.01662,\"pacifica\":0.00579,\"grvt\":0.005202,\"gmx\":0.01119,\"orderly\":0.008965,\"aevo\":0.008955,\"paradex\":0.005864,\"bluefin\":0.03897}},\"units\":{\"rates\":\"fractions (0.0001 = 0.01%)\",\"money\":\"US dollars\",\"funding\":\"what a long pays per hour (negative: shorts pay longs), annualized as hourly × 8,760: a snapshot, not a forecast; fundingRateRaw is one interval's rate (fundingIntervalHours); fundingCumulative is what a long paid over each window, per venue (venue:symbol where a venue lists the market more than once); predictedFunding is a venue's own estimate of a settlement still to come, where its reading publishes one\",\"openInterest\":\"Open interest is one side of the market: every open contract has a long and a short holder, so it shows how much is open, not which way traders lean. On pool venues (GMX, gTrade, Jupiter, Ostium, Variational, Vest, Veranta) it is traders' longs plus shorts, each facing the pool. Hyperliquid and its builder dexes publish both sides, twice the figure here. Binance's markets are its latest archived hour (readAt; its public archive publishes a UTC day the next day): in the open-interest total, and not in the 24-hour change, funding, prices or volume, which are over the markets read this hour.\",\"openInterestChange24h\":\"The day's change over the markets read at both ends, which hold the open interest totalled here to within 2%; in US dollars, so it includes the price move.\",\"openInterestChange\":\"A change in USD open interest includes the price move; quantityChange values each market at its starting price.\",\"openInterestSides\":\"On a pool venue (GMX, gTrade, Jupiter, Ostium, Variational, Vest, Veranta), openInterestLongUsd is the dollars of traders' open longs and openInterestShortUsd of their open shorts; they add up to the market's open interest, and the pool holds the other side of each. openInterestLineage gives each venue's formula and whether its dollars are the venue's own (reported) or worked out from its figures (derived). longShare is the longs' part of the two. An order-book venue has no such split: each open long there faces an open short.\",\"openInterestCap\":\"on Hyperliquid and its builder dexes: whether the market sits at its open-interest cap in the latest hourly reading (where it cannot grow its open interest), since when, and the cap in USD of one side's open interest where the dex publishes one\"},\"markets\":[{\"venue\":\"binance\",\"symbol\":\"XAUUSDT\",\"openInterestUsd\":688521904,\"fundingIntervalHours\":1.0,\"fundingState\":\"not_read\",\"readAt\":\"2026-10-27T23:00:00Z\",\"availability\":{\"price\":\"not_read\",\"volume24hUsd\":\"not_read\",\"fundingRateHourly\":\"not_read\",\"premiumToIndexBps\":\"not_read\"}},{\"venue\":\"mexc\",\"symbol\":\"XAU_USDT\",\"price\":4043.93,\"openInterestUsd\":477602513,\"openInterestBase\":118104.0,\"fundingRateHourly\":0.0,\"fundingRateAnnualized\":0.0,\"fundingRateRaw\":0.0,\"fundingIntervalHours\":4.0,\"fundingState\":\"current_indicative\",\"volume24hUsd\":577517337,\"maxLeverage\":1000.0,\"premiumToIndexBps\":3.74,\"readAt\":\"2026-10-29T00:48:06Z\",\"availability\":{\"fundingRateHourly\":\"reported_zero\"},\"fundingObservedAt\":\"2026-10-29T00:48:06Z\"},{\"venue\":\"okx\",\"symbol\":\"XAU-USDT-SWAP\",\"price\":4045.1,\"openInterestUsd\":226352110,\"openInterestBase\":55957.1,\"fundingRateHourly\":3.803e-6,\"fundingRateAnnualized\":0.03331,\"fundingRateRaw\":0.00003042,\"fundingIntervalHours\":8.0,\"fundingState\":\"current_indicative\",\"volume24hUsd\":318434276,\"maxLeverage\":100.0,\"premiumToIndexBps\":7.2,\"readAt\":\"2026-10-29T00:48:05Z\",\"fundingObservedAt\":\"2026-10-29T00:48:05Z\"},{\"venue\":\"gate\",\"symbol\":\"XAU_USDT\",\"price\":4045.92,\"openInterestUsd\":164346330,\"openInterestBase\":40620.3,\"fundingRateHourly\":0.0000235,\"fundingRateAnnualized\":0.2059,\"fundingRateRaw\":0.000094,\"fundi