data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"type\":\"perps_market\",\"as_of\":\"2026-10-27T00:00:00Z\",\"confidence\":\"computed\",\"source\":{\"name\":\"OptimistFi perps data layer — each venue's public market data, read hourly\",\"url\":\"https://optimistfi.com/perps\",\"license\":\"computed\"},\"data\":{\"view\":\"fear_greed\",\"found\":true,\"asOf\":\"2026-10-27T00:00:00Z\",\"since\":\"2013-05-30T00:00:00Z\",\"latest\":{\"index\":78.6,\"label\":\"extreme greed\"},\"inputs\":[{\"input\":\"volatility\",\"score\":95.3,\"value\":0.2513,\"definition\":\"Bitcoin's 30-day volatility (daily closes), ranked against its own past year: calmer reads greedier.\"},{\"input\":\"momentum\",\"score\":72.1,\"value\":0.05009,\"definition\":\"Bitcoin's close against its 90-day average, ranked against the past year: further above reads greedier.\"},{\"input\":\"funding\",\"score\":82.7,\"value\":8.995e-6,\"definition\":\"Bitcoin's funding rate, the day's average on each venue with a settled history, averaged across them, ranked against the past year: higher reads greedier.\"},{\"input\":\"openInterest\",\"score\":75.6,\"value\":0.07315,\"definition\":\"Bitcoin's open interest in coins, its 7-day change on the venues read at both ends, ranked against its own history: building reads greedier.\"},{\"input\":\"longShort\",\"score\":66.3,\"value\":1.679,\"definition\":\"Accounts long per account short on Bitcoin's perps: each venue's readings that day and then the venues combined as a geometric mean (1.41 and 1.72 make 1.56), ranked against its own history.\"},{\"input\":\"liquidations\",\"score\":79.3,\"value\":0.7931,\"definition\":\"The day's Bitcoin liquidations that were shorts, as a share of all liquidated: shorts squeezed reads greedy.\"}],\"points\":[{\"at\":\"2026-10-23T00:00:00Z\",\"index\":69.2,\"label\":\"greed\",\"inputs\":[\"volatility\",\"momentum\",\"funding\",\"openInterest\",\"longShort\",\"liquidations\"]},{\"at\":\"2026-10-24T00:00:00Z\",\"index\":64.0,\"label\":\"greed\",\"inputs\":[\"volatility\",\"momentum\",\"funding\",\"openInterest\",\"longShort\",\"liquidations\"]},{\"at\":\"2026-10-25T00:00:00Z\",\"index\":63.9,\"label\":\"greed\",\"inputs\":[\"volatility\",\"momentum\",\"funding\",\"openInterest\",\"longShort\",\"liquidations\"]},{\"at\":\"2026-10-26T00:00:00Z\",\"index\":68.2,\"label\":\"greed\",\"inputs\":[\"volatility\",\"momentum\",\"funding\",\"openInterest\",\"longShort\",\"liquidations\"]},{\"at\":\"2026-10-27T00:00:00Z\",\"index\":78.6,\"label\":\"extreme greed\",\"inputs\":[\"volatility\",\"momentum\",\"funding\",\"openInterest\",\"longShort\",\"liquidations\"]}],\"methodology\":\"The mean of the inputs scored that day, 0 (extreme fear) to 100 (extreme greed); each input is ranked against its own previous 365 days (at least 30 needed), liquidations read directly. Bands: below 25 extreme fear, 25-44 fear, 45-55 neutral, 56-75 greed, 76 and up extreme greed.\"}}"}],"isError":false}}

