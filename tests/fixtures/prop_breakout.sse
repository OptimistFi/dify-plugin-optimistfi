data: {"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"type\":\"prop_firms\",\"as_of\":\"2026-10-28\",\"confidence\":\"reported\",\"source\":{\"name\":\"Each firm's own public pages, read by OptimistFi\",\"url\":\"https://optimistfi.com/perps/props\",\"license\":\"computed\"},\"data\":{\"count\":1,\"firms\":[{\"slug\":\"breakout\",\"name\":\"Breakout\",\"website\":\"https://www.breakoutprop.com/\",\"tradesOn\":[\"own simulated platform (Breakout Terminal)\",\"DXtrade for pre-existing accounts only\"],\"markets\":\"crypto, index and commodity (S&P 500, Nasdaq 100, WTI crude, silver)\",\"onChain\":false,\"model\":\"1-step evaluation (Classic, Pro or Turbo)\",\"accountSizesUsd\":[5000,10000,25000,50000,100000,200000],\"profitTargetPct\":\"9% (Turbo) / 10% (Classic) / 12% (Pro), single phase\",\"maxDailyLossPct\":\"3%, recalculated daily at 00:30 UTC from balance (Classic, Pro and Turbo); none on Spark, which is sold out\",\"maxDrawdownPct\":\"3% (Turbo) / 5% (Pro) / 6% (Classic), static from starting balance\",\"profitSplit\":\"80%; 90% with an add-on bought at checkout\",\"payoutCadence\":\"Any time, weekdays and weekends, with no open positions; $50 minimum after split; no approval queue, most requests processed within hours; paid in USDC on Ethereum\",\"maxLeverage\":\"10x on BTC, the S&P 500 and the Nasdaq 100; 5x on ETH, SOL, other majors, WTI crude and silver; 3x on a listed set; 2x on all others (fixed per market, not user-adjustable; per its symbol list)\",\"startingPriceUsd\":\"from $20 for a $5,000 account (1-Step Turbo)\",\"minTradingDays\":\"None\",\"consistencyRule\":\"None\",\"usTraders\":\"Yes (not on its restricted list)\",\"feeRefund\":\"No (active evaluations refunded if KYC is rejected)\",\"newsTrading\":\"Allowed\",\"weekendHolding\":\"Allowed\",\"entry\":{\"usd\":20,\"accountUsd\":5000},\"notes\":\"Owned by Kraken (Payward); 71 markets on its symbol list, including S&P 500, Nasdaq 100, WTI crude and silver perps; all balances are simulated, KYC via SumSub is required before a funded account, the Classic plan tops out at $100,000, and traders in a listed set of sanctioned jurisdictions are ineligible. A Spark plan ($139 for a $50,000 account, no daily loss limit, a $1,500 trailing maximum loss, 40x on the S&P 500 and Nasdaq 100) sold all 1,500 evaluations in its release and has a waitlist. Its program-rules page still lists its two index perps at 5x, and its pricing page counts 63 markets.\",\"sources\":[\"https://www.breakoutprop.com/\",\"https://www.breakoutprop.com/pricing\",\"https://www.breakoutprop.com/symbols/\",\"https://www.breakoutprop.com/program-rules/\",\"https://www.breakoutprop.com/kraken/\",\"https://www.breakoutprop.com/products/spark/\",\"https://www.breakoutprop.com/pricing/\",\"https://intercom.help/breakoutprop/en/articles/11644118-which-countries-are-ineligible-for-breakout-services\"],\"checkedAt\":\"2026-10-27\",\"programs\":[{\"name\":\"1-Step Classic\",\"steps\":1,\"accountUsd\":5000,\"priceUsd\":45,\"profitTargetsPct\":[10],\"maxLossPct\":6,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-classic-5k\"},{\"name\":\"1-Step Classic\",\"steps\":1,\"accountUsd\":10000,\"priceUsd\":85,\"profitTargetsPct\":[10],\"maxLossPct\":6,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-classic-10k\"},{\"name\":\"1-Step Classic\",\"steps\":1,\"accountUsd\":25000,\"priceUsd\":215,\"profitTargetsPct\":[10],\"maxLossPct\":6,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-classic-25k\"},{\"name\":\"1-Step Classic\",\"steps\":1,\"accountUsd\":50000,\"priceUsd\":400,\"profitTargetsPct\":[10],\"maxLossPct\":6,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-classic-50k\"},{\"name\":\"1-Step Classic\",\"steps\":1,\"accountUsd\":100000,\"priceUsd\":800,\"profitTargetsPct\":[10],\"maxLossPct\":6,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-classic-100k\"},{\"name\":\"1-Step Pro\",\"steps\":1,\"accountUsd\":5000,\"priceUsd\":33,\"profitTargetsPct\":[12],\"maxLossPct\":5,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-pro-5k\"},{\"name\":\"1-Step Pro\",\"steps\":1,\"accountUsd\":10000,\"priceUsd\":65,\"profitTargetsPct\":[12],\"maxLossPct\":5,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"pa