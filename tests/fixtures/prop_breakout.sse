ic\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-5k\"},{\"name\":\"1-Step Turbo\",\"steps\":1,\"accountUsd\":10000,\"priceUsd\":40,\"profitTargetsPct\":[9],\"maxLossPct\":3,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-10k\"},{\"name\":\"1-Step Turbo\",\"steps\":1,\"accountUsd\":25000,\"priceUsd\":95,\"profitTargetsPct\":[9],\"maxLossPct\":3,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-25k\"},{\"name\":\"1-Step Turbo\",\"steps\":1,\"accountUsd\":50000,\"priceUsd\":180,\"profitTargetsPct\":[9],\"maxLossPct\":3,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-50k\"},{\"name\":\"1-Step Turbo\",\"steps\":1,\"accountUsd\":100000,\"priceUsd\":330,\"profitTargetsPct\":[9],\"maxLossPct\":3,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-100k\"},{\"name\":\"1-Step Turbo\",\"steps\":1,\"accountUsd\":200000,\"priceUsd\":660,\"profitTargetsPct\":[9],\"maxLossPct\":3,\"dailyLossPct\":3,\"maxLossType\":\"static\",\"maxLossBasis\":\"equity\",\"profitSplitPct\":80,\"payoutFrequency\":\"On demand, 24/7\",\"maxLeverageBtcEth\":{\"btc\":10,\"eth\":5},\"pairsCount\":71,\"source\":\"https://www.breakoutprop.com/pricing\",\"page\":\"https://optimistfi.com/perps/props/breakout/1-step-turbo-200k\"}],\"programsCheckedAt\":\"2026-10-23\",\"page\":\"https://optimistfi.com/perps/props/breakout\",\"profile\":{\"country\":\"United States\",\"entity\":\"Breakout Trading Group, LLC\",\"founded\":\"2023-11\",\"yearsInOperation\":2,\"platforms\":[\"Breakout Terminal\"],\"maxAllocationUsd\":200000,\"sources\":[\"https://intercom.help/breakoutprop/en/articles/11643973-is-payward-oceanic-ltd-pol-the-same-company-as-breakout-trading-group\",\"https://intercom.help/breakoutprop/en/articles/11647295-is-my-relationship-with-payward-oceanic-ltd-pol-the-same-as-my-relationship-with-breakout-trading-group-llc\",\"https://intercom.help/breakoutprop/en/articles/14215629-does-breakout-offer-two-separate-trading-terminals\",\"https://intercom.help/breakoutprop/en/articles/11647273-what-trading-platforms-does-payward-oceanic-ltd-pol-support\",\"https://intercom.help/breakoutprop/en/articles/11647204-what-is-the-maximum-allocation-available\",\"https://www.breakoutprop.com/terms-of-use/\",\"https://www.breakoutprop.com/llms.txt\"]},\"assets\":[\"Crypto\",\"Indices\",\"Commodities\"],\"offers\":[],\"lists\":[\"static-drawdown\",\"under-50\",\"200k-accounts\",\"us-traders\",\"no-minimum-days\"],\"bitcoin\":[{\"program\":\"Classic, Pro and Turbo\",\"dailyLossPct\":3,\"leverage\":10,\"breachMovePct\":0.3}],\"trackedSince\":\"2026-09-23\",\"changes\":[{\"firm\":\"breakout\",\"date\":\"2026-10-27\",\"dateKind\":\"seen\",\"rule\":\"payouts\",\"what\":\"Changed its payout terms from \\\"Any time, weekdays and weekends, with no open positions; $50 minimum after split; approval can take 12-24 hours; paid in USDC on Ethereum\\\" to \\\"Any time, weekdays and weekends, with no open positions; $50 minimum after split; no approval queue, most requests processed within hours; paid in USDC on Ethereum\\\".\",\"sources\":[\"https://www.breakoutprop.com/\"]},{\"firm\":\"breakout\",\"date\":\"2026-10-02\",\"dateKind\":\"seen\",\"seenBefore\":\"2026-09-28\",\"rule\":\"program\",\"what\":\"Added Spark, a $50,000 one-step account at $139 with a 6% target, a $1,500 trailing drawdown and no daily loss limit; it is sold out.\",\"sources\":[\"https://web.archive.org/web/20261002073725/https://www.breakoutprop.com/\",\"https://www.breakoutprop.com/products/spark/\"],\"story\":\"three-more-crypto-prop-firms-dropped-the-daily-loss-limit\"},{\"firm\":\"breakout\",\"date\":\"2026-08-14\",\"dateKind\":\"announced\",\"rule\":\"leverage\",\"what\":\"Raised leverage or position limits on more than 30 other markets, most from 2x to 5x, among them BNB, XRP, LINK, LTC, AVAX and DOGE.\",\"sources\":[\"https://www.breakoutprop.com/article/leverage-increase-rest-of-the-book/\"]},{\"firm\":\"breakout\",\"date\":\"2026-08-12\",\"dateKind\":\"announced\",\"rule\":\"leverage\",\"what\":\"Raised leverage on Bitcoin, the Nasdaq 100 and the S&P 500 from 5x to 10x, on SOL from 2x to 5x and on HYPE from 2x to 3x, and doubled the S&P 500 maximum position to $2,000,000.\",\"sources\":[\"https://www.breakoutprop.com/article/10x-leverage-increase/\"],\"story\":\"breakout-lifts-bitcoin-and-index-perps-to-10x\"},{\"firm\":\"breakout\",\"date\":\"2026-08-06\",\"dateKind\":\"announced\",\"rule\":\"markets\",\"what\":\"Added WTI crude oil and silver at 5x leverage with a $200,000 maximum position on each.\",\"sources\":[\"https://www.breakoutprop.com/article/oil-silver-launch/\"]},{\"firm\":\"breakout\",\"date\":\"2026-08-03\",\"dateKind\":\"announced\",\"rule\":\"markets\",\"what\":\"Added the S&P 500 at 5x leverage with a $1,000,000 maximum position.\",\"sources\":[\"https://www.breakoutprop.com/article/sp500-launch/\"]},{\"firm\":\"breakout\",\"date\":\"2026-07-31\",\"dateKind\":\"seen\",\"seenBefore\":\"2026-07-26\",\"rule\":\"leverage\",\"what\":\"Raised the Nasdaq 100 from 2x to 5x leverage; its maximum position later rose from $100,000 to $1,000,000.\",\"sources\":[\"https://web.archive.org/web/20260726034207/https://www.breakoutprop.com/symbols/\",\"https://web.archive.org/web/20260731065539/https://www.breakoutprop.com/program-rules/\",\"https://web.archive.org/web/20260808163011/https://www.breakoutprop.com/symbols/\"]},{\"firm\":\"breakout\",\"date\":\"2026-07-31\",\"dateKind\":\"seen\",\"seenBefore\":\"2026-07-20\",\"rule\":\"kyc\",\"what\":\"Extended its refund on a failed identity check from one evaluation to every evaluation active at the time.\",\"sources\":[\"https://web.archive.org/web/20260720200340/https://www.breakoutprop.com/program-rules/\",\"https://web.archive.org/web/20260731065539/https://www.breakoutprop.com/program-rules/\"]},{\"firm\":\"breakout\",\"date\":\"2026-07-20\",\"dateKind\":\"announced\",\"rule\":\"markets\",\"what\":\"Added the Nasdaq 100 (XYZ100), its first market outside crypto, at 2x leverage and a $100,000 maximum position.\",\"sources\":[\"https://www.breakoutprop.com/article/nasdaq-100-launch/\",\"https://web.archive.org/web/20260726034207/https://www.breakoutprop.com/symbols/\"]},{\"firm\":\"breakout\",\"date\":\"2026-05-28\",\"dateKind\":\"seen\",\"seenBefore\":\"2025-09-28\",\"rule\":\"other\",\"what\":\"Allowed holding several evaluations at once, up to $200,000 of combined account size, where one evaluation at a time had been the limit.\",\"sources\":[\"https://web.archive.org/web/20250928052831/https://www.breakoutprop.com/program-rules/\",\"https://web.archive.org/web/20260528041029/https://www.breakoutprop.com/program-rules/\"]}],\"confirmed\":\"2026-10-28\",\"rulesConfirmed\":\"2026-10-28\",\"pricesReadAt\":\"2026-10-28T01:31:46.723Z\",\"rulesReadAt\":\"2026-10-28T01:31:46.723Z\",\"changesCount\":25}],\"pages\":{\"methodology\":\"https://optimistfi.com/perps/props/methodology\",\"changesLog\":\"https://optimistfi.com/perps/props/changes\",\"hyperliquidHub\":\"https://optimistfi.com/perps/props/hyperliquid\"}}}"}],"isError":false}}

